{
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rmdir *": "ask",
      "mv *": "ask",
      "cp *": "ask",
      "dd *": "ask",
      "shred *": "ask",
      "mkfs*": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "kill *": "ask",
      "pkill *": "ask",
      "killall *": "ask",
      "shutdown *": "ask",
      "reboot *": "ask",
      "halt *": "ask",
      "poweroff *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git add *": "ask",
      "git rm *": "ask",
      "git stash *": "ask",
      "git reset *": "ask",
      "git checkout *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git revert *": "ask",
      "git clean *": "ask",
      "git tag *": "ask",
      "> *": "ask",
      "sudo *": "deny"
    },
    "edit": {
      "*": "ask"
    },
    "write": {
      "*": "ask"
    }
  }
}
